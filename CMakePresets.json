{
    "version": 6,
    "configurePresets": [
        {
            "name": "windows-base",
            "description": "Target Windows with the Visual Studio development environment.",
            "hidden": true,
            "generator": "Visual Studio 18 2026",
            "binaryDir": "${sourceDir}/msvc.build/${presetName}",
            "installDir": "${sourceDir}/msvc.install/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe",
                "CMAKE_WARN_DEPRECATED": "FALSE"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "x64-Debug",
            "displayName": "x64 Debug",
            "description": "Target Windows (64-bit) with the Visual Studio development environment. (Debug)",
            "inherits": "windows-base",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "MUSE_COMPILE_BUILD_64": "ON"
            }
        },
        {
            "name": "x64-MinSizeRel",
            "displayName": "x64 Release",
            "description": "Target Windows (64-bit) with the Visual Studio development environment. (MinSizeRel)",
            "inherits": "x64-Debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "MinSizeRel"
            }
        },
        {
            "name": "x64-Release",
            "displayName": "x64 Release",
            "description": "Target Windows (64-bit) with the Visual Studio development environment. (Release)",
            "inherits": "x64-Debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "x64-RelWithDebInfo",
            "displayName": "x64 RelWithDebInfo",
            "description": "Target Windows (64-bit) with the Visual Studio development environment. (RelWithDebInfo)",
            "inherits": "x64-Debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "ninja-base",
            "description": "Use current Qt with Ninja",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{QT_DIR}/lib/cmake/Qt6/qt.toolchain.cmake",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/${presetName}/install",
                "CMAKE_PREFIX_PATH": "$env{QT_DIR}/lib/cmake",
                "QT_QML_GENERATE_QMLLS_INI": "ON",
                "CMAKE_CXX_FLAGS_DEBUG_INIT": "-DQT_QML_DEBUG -DQT_DECLARATIVE_DEBUG",
                "CMAKE_CXX_FLAGS_RELWITHDEBINFO_INIT": "-DQT_QML_DEBUG -DQT_DECLARATIVE_DEBUG"
            }
        },
        {
            "name": "clang-base",
            "displayName": "Qt Clang",
            "description": "Use current Qt with Clang compiler",
            "hidden": true,
            "inherits": "ninja-base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "Qt-Clang-Debug",
            "displayName": "Qt Clang Debug",
            "description": "Use current Qt with Clang compiler (Debug)",
            "inherits": "clang-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "compile_commands",
            "displayName": "Generate compile_commands",
            "description": "Use current Qt with Clang compiler (Debug)",
            "inherits": "clang-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "MUSE_COMPILE_USE_UNITY": "OFF",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "msvc-base",
            "displayName": "Qt Msvc",
            "description": "Use current Qt with Msvc compiler",
            "hidden": true,
            "inherits": "ninja-base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "Qt-Msvc-Debug",
            "displayName": "Qt Msvc Debug",
            "description": "Use current Qt with Msvc compiler (Debug)",
            "inherits": "msvc-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "ios-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{QT_IOS_DIR}/lib/cmake/Qt6/qt.toolchain.cmake",
                "QT_HOST_PATH": "$env{QT_HOST_DIR}",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "17.0",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/${presetName}/install",
                "MUSESCORE_BUILD_CONFIGURATION": "app-ios",
                "MUE_IOS_BUNDLE_IDENTIFIER": "com.jmx.cantoforge",
                "MUSE_APP_BUILD_MODE": "dev",
                "MUSE_COMPILE_USE_COMPILER_CACHE": "OFF",
                "MUE_DOWNLOAD_SOUNDFONT": "OFF"
            }
        },
        {
            "name": "ios-device",
            "inherits": "ios-base",
            "displayName": "iPadOS device (arm64)",
            "cacheVariables": {
                "CMAKE_OSX_SYSROOT": "iphoneos",
                "CMAKE_OSX_ARCHITECTURES": "arm64"
            }
        },
        {
            "name": "ios-simulator",
            "inherits": "ios-base",
            "displayName": "iPadOS simulator (Intel Qt simulator libraries)",
            "cacheVariables": {
                "CMAKE_OSX_SYSROOT": "iphonesimulator",
                "CMAKE_OSX_ARCHITECTURES": "x86_64"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "ios-device",
            "configurePreset": "ios-device",
            "targets": [
                "MuseScoreStudio"
            ]
        },
        {
            "name": "ios-simulator",
            "configurePreset": "ios-simulator",
            "targets": [
                "MuseScoreStudio"
            ]
        }
    ]
}
